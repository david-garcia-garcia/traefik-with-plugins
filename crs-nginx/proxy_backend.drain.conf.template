# Inspect-only overlay for owasp/modsecurity-crs:4.3.0-nginx-alpine-202406090906
# includes/proxy_backend.conf.template. Stock file plus empty If-None-Match /
# If-Modified-Since so the in-process return 200 origin is not rewritten to 304
# (nginx not_modified filter: If-None-Match * matches any 200).
# CRS rewrite/preaccess already ran on the public server, so ModSecurity still
# sees the client headers. Mount at:
# /etc/nginx/templates/includes/proxy_backend.conf.template
# Origin is unix:/tmp/modsecurity/crs-drain.sock (crs-nginx/drain-origin.conf).
# Hard-code that URI — this pin's $upstream is a TCP BACKEND map, and later CRS
# images use ${PROXY_HOST_HEADER} / ${BACKEND} which nginx rejects here.
# Keep Host $host from this pin.
#
# Copied from david-garcia-garcia/traefik-modsecurity crs-nginx/proxy_backend.drain.conf.template

proxy_set_header Host $host;
proxy_set_header Proxy "";
proxy_set_header Upgrade $http_upgrade;
proxy_set_header Connection $connection_upgrade;
proxy_set_header ${REAL_IP_PROXY_HEADER} $remote_addr;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Port $server_port;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header If-None-Match "";
proxy_set_header If-Modified-Since "";

proxy_http_version 1.1;
proxy_buffering off;
proxy_connect_timeout 60s;
proxy_read_timeout 36000s;
proxy_redirect off;

proxy_pass_header Authorization;
proxy_pass http://unix:/tmp/modsecurity/crs-drain.sock:;

SET_REAL_IP_FROM
real_ip_header ${REAL_IP_HEADER};
real_ip_recursive ${REAL_IP_RECURSIVE};
